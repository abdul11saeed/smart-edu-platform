{
  "storage": {
    "rules": "src/firebase/storage.rules",
    "cors": "storage-cors.json"
  },
  "firestore": {
    "rules": "src/firebase/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "src/firebase/realtime-rules.json"
  },
  "hosting": {
    "public": "yemen_U_A",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
