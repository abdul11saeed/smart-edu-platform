# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Backend API Configuration
# Frontend will call internal backend API which handles secrets securely
# Using proxy through Vite dev server
VITE_API_BASE_URL=/api

# Optional: For production, you can set a custom API base URL
# VITE_API_BASE_URL=https://your-domain.com/api